{
  "name": "jetking-adaptive-website",
  "version": "0.1.0",
  "private": true,
  "description": "Jetking adaptive website — Phase 1. Persona-adaptive, SEO-safe, AI-guided.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:seo": "tsx scripts/verify-redirects.ts",
    "crawl:legacy": "tsx scripts/crawl-legacy.ts",
    "build:redirects": "tsx scripts/build-redirects.ts",
    "migrate:cms": "tsx scripts/migrate-cms.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "create:admin": "tsx scripts/create-admin-user.ts",
    "migrate:blog": "tsx scripts/migrate-blog.ts",
    "sync:investors": "node scripts/sync-investor-disclosures.mjs",
    "localize:media": "node scripts/localize-media.mjs",
    "sync:chatbot-content": "node scripts/sync-content.mts",
    "export:chatbot-content": "node --conditions=react-server --import tsx scripts/export-site-corpus.mts",
    "check:chatbot-answers": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/check-answers.mts",
    "model:setup": "node scripts/setup-local-model.mjs",
    "model:check": "node scripts/check-local-model.mjs",
    "build:chatbot-index": "npm run export:chatbot-content && node scripts/build-index.mjs --embed",
    "inspect:chatbot-index": "node scripts/build-index.mjs",
    "eval:chatbot-retrieval": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/eval-retrieval.mjs",
    "eval:conversations": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/eval-conversations.mts",
    "ingest:manual-knowledge": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/ingest-manual-knowledge.mts",
    "report:unanswered": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/unanswered-report.mts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:seo": "npm run verify:seo"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.0",
    "@xenova/transformers": "^2.17.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
