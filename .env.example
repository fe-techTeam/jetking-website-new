# ─── Site ──────────────────────────────────────────────────────────────────
# Absolute origin. Used for canonical URLs, sitemap, OG tags. Must be set in prod.
# Server-only (not exposed to browser).
SITE_URL=http://localhost:3000

# National enquiry line, E.164 (e.g. +912212345678). Unset => "call us" affordances
# link to /centres, whose pages carry each centre's own number.
# NEXT_PUBLIC_PHONE=

# ─── Persona engine ────────────────────────────────────────────────────────
# HMAC secret for signing the jk_persona cookie. Generate: openssl rand -hex 32
PERSONA_COOKIE_SECRET=dev-only-insecure-secret-replace-in-production

# ─── Content source ────────────────────────────────────────────────────────
# 'admin' (default) = Admin CMS: Postgres when DATABASE_URL is set, else the file store seeded from fixtures.
# 'local' = read the repo fixtures directly (ignores CMS edits).
CONTENT_SOURCE=admin

# ─── Supabase (Admin CMS + pgvector) ───────────────────────────────────────
# When unset, Admin CMS uses the local file store under data/cms/.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Leads / CRM) ────────────────────────────────────────────────
# Plain Postgres connection string, read directly via Drizzle + node-postgres —
# @supabase/supabase-js is never involved on this path, even if the string happens
# to point at a Supabase-hosted database. Works with any Postgres instance.
# After setting this, run: npm run db:migrate
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to 'false' only for a local Postgres without TLS.
# DATABASE_SSL=true

# ─── AI (Jetking AI chat + persona inference) ──────────────────────────────
# Chat answers without OpenAI by default:
#   GUIDE_PROVIDER=local  (default) → Ollama if running, else KB/catalogue passages
#   GUIDE_PROVIDER=auto   → Ollama first, then OpenAI if OPENAI_API_KEY is set
#   GUIDE_PROVIDER=openai → OpenAI only (requires OPENAI_API_KEY)
# GUIDE_PROVIDER=local
OPENAI_API_KEY=
GUIDE_MODEL=gpt-4o
GUIDE_ENABLED=true
# Optional: silent persona model (falls back to heuristic if unset / no key)
# Personalisation. Default (unset): the site behaves like a normal website. Nothing is inferred about a
# visitor (no first-touch classification, no persona cookie, no behaviour learning, no model call); content
# adapts to an audience only when the visitor picks one (home chooser, student journey) and the choice is
# remembered in their own browser. Set to 'adaptive' to turn the original inference engine back on.
# Centre pages show "To be updated" placeholders where a centre has no content yet (About strip, people, What's new).
# Set to false to hide them and show only real content.
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
# NEXT_PUBLIC_PERSONA_MODE=adaptive
# PERSONA_INFER_MODEL=gpt-4o-mini
# REVALIDATE_SECRET=   # shared secret for /api/revalidate + ingest hooks

# ─── Analytics ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Mobile OTP verification (enquiry forms) ───────────────────────────────
# Visitors verify their mobile number with an SMS code before an enquiry is accepted. Switch it on with BOTH
# flags (the first makes the server refuse unverified enquiries, the second shows the step in the forms):
# OTP_ENABLED=true
# NEXT_PUBLIC_OTP_ENABLED=true
# Signs the OTP hashes and the "verified" token. REQUIRED in production when OTP is on. Generate: openssl rand -hex 32
# OTP_SECRET=
# SMS gateway (HTTP GET API). The key is a SERVER-SIDE secret — never put it in a NEXT_PUBLIC_ variable.
# SMS_AUTH_KEY=
# SMS_OTP_TEMPLATE_ID=      # the DLT template id for: Your OTP code is {#var#} - Jetking Infotrain Ltd
# SMS_SENDER_ID=JTKING
# SMS_ROUTE=1
# SMS_ENDPOINT=https://msg.clickconnectmedia.in/http-tokenkeyapi.php
# Local development only: with no SMS key, return the code to the page instead of texting it.
# OTP_DEV_ECHO=true
# Needs DATABASE_URL in production (attempt counts and send limits must be shared across instances):
# run `npm run db:migrate` for the otp_challenges table.

# ─── Logging ───────────────────────────────────────────────────────────────
# Lead details (name, phone, email, message) are masked in server logs in production. Outside production the
# full payload is logged (it is the only record when no database or CRM is configured). Set to 'true' to log
# full payloads in production too (only if your logs are access-controlled), or 'false' to mask everywhere.
# LOG_LEAD_PAYLOADS=

# ─── Rate limiting ─────────────────────────────────────────────────────────
# How many reverse proxies / load balancers of yours append to X-Forwarded-For (default 1). The client IP used
# as the rate-limit key is the entry that many from the right, so a caller cannot dodge limits by sending their
# own header. Set 0 if the app is reached directly (everyone then shares one bucket). On Vercel the platform
# header is used automatically.
# TRUSTED_PROXY_HOPS=1
# Default 'memory' counts per process, so it under-limits on a multi-instance
# deployment. A production server REFUSES TO BOOT on 'memory' unless you set
# RATE_LIMIT_ALLOW_MEMORY=true — deploying single-instance is a valid choice, but
# it has to be a deliberate one.
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_ALLOW_MEMORY=true

# ─── Enquiry / CRM ─────────────────────────────────────────────────────────
# Existing Jetking enquiry endpoint. Absent => enquiries are logged, not dropped.
# CRM_PROVIDER=smartrain   # use the Smartrain adapter (src/lib/crm/smartrain.ts): JSON, numeric state/city/center ids,
#                          # needs email + a mapped centre (else the lead is kept here and marked Not sent).
#                          # Unset = the generic JSON hand-off below.
# CRM_ENDPOINT=https://crm.smartrain.org/externalInquirySave
# CRM_API_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Website accounts (public visitors — register/login, `users` table) ────
# Signs the jk_user_session cookie for the main website's own register/login.
# REQUIRED in production — the server refuses to issue sessions without it.
# Separate from ADMIN_SESSION_SECRET and CHATBOT_SESSION_SECRET. Generate: openssl rand -hex 32
# USER_SESSION_SECRET=

# ─── /chatbot accounts (public visitors, kept separate from the above) ─────
# Signs the jk_chat_session cookie for /chatbot's own accounts (`chat_users` table).
# REQUIRED in production — the server refuses to issue sessions without it.
# Separate from ADMIN_SESSION_SECRET and USER_SESSION_SECRET. Generate: openssl rand -hex 32
# CHATBOT_SESSION_SECRET=

# ─── Admin ─────────────────────────────────────────────────────────────────
# Real multi-user accounts (roles: admin / editor / centre_staff) when
# DATABASE_URL is set — see "Database (Leads / CRM)" above; same table.
# Signs session cookies, independent of any one user's password — rotating it
# revokes every session at once. Generate: openssl rand -hex 32
# ADMIN_SESSION_SECRET=
# Bootstrap the first admin (Team & Access itself needs one to sign in):
#   npm run create:admin -- --name "Your Name" --email you@example.com --password "..."

# Legacy single shared-password gate for /admin, used ONLY when DATABASE_URL
# is unset — every visitor who knows it gets full admin access, no per-user
# accounts or roles. Set DATABASE_URL instead for real multi-user access.
# ADMIN_PASSWORD=changeme

# ─── Jetking AI assistant ───────────────────────────────────────────────────
# The assistant works from its local knowledge base without Ollama. When an
# Ollama model is available, it can compose grounded answers from retrieved data.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I would like to know more about Jetking courses.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=jetking-assistant
# Keep false: the assistant should answer only from the local Jetking
# knowledge base, never from the model's own general training knowledge.
JK_ALLOW_GENERAL_ANSWERS=false
JK_ANSWER_GATE=0.42
JK_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
JK_LEXICAL_WEIGHT=0.08
JK_LEXICAL_DEPTH=25
JK_CITY_BOOST=0.2
JK_RETRIEVAL_MODE=auto
# JK_INDEX_PATH=
# OLLAMA_TIMEOUT_MS=20000
