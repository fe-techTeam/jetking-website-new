# ══════════════════════════════════════════════════════════════════════════════
# Jetking website — PRODUCTION environment template
#
# This file is a TEMPLATE: every secret below is a placeholder (CHANGE_ME_…).
# Never put real values in this file or commit them. Set the real values in
# Vercel → Project → Settings → Environment Variables (target: Production), or:
#
#     vercel env add NAME production --sensitive
#
# Mark every secret "Sensitive". Redeploy after changing anything:  vercel deploy --prod
# Generate a random secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Legend:  [REQUIRED] the server refuses to start / the feature fails without it
#          [RECOMMENDED] works without, but you want it in production
#          [OPTIONAL] leave out unless you use the feature
# ══════════════════════════════════════════════════════════════════════════════


# ─── 1. Site identity ─────────────────────────────────────────────────────────
# [REQUIRED] Public origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
SITE_URL=https://www.jetking.com
NEXT_PUBLIC_SITE_URL=https://www.jetking.com

# [RECOMMENDED] National enquiry line (E.164) and WhatsApp number (digits only, with country code).
# Unset/placeholder WhatsApp numbers hide the WhatsApp buttons.
NEXT_PUBLIC_PHONE=+912212345678
NEXT_PUBLIC_WHATSAPP_NUMBER=919XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I would like to know more about Jetking courses.

# [RECOMMENDED] Hide the "To be updated" placeholder tiles shown where content is not written yet.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Search engines. Leave unset (indexing allowed) on the real site; set to false on staging / preview.
# NEXT_PUBLIC_ALLOW_INDEXING=false


# ─── 2. Secrets the server refuses to run without in production ───────────────
# [REQUIRED] Each must be a long random string, all different from each other.
PERSONA_COOKIE_SECRET=CHANGE_ME_random_32_bytes_hex     # signs the visitor persona cookie
REVALIDATE_SECRET=CHANGE_ME_random_32_bytes_hex         # protects POST /api/revalidate
ADMIN_SESSION_SECRET=CHANGE_ME_random_32_bytes_hex      # signs admin session cookies (rotating it signs everyone out)
USER_SESSION_SECRET=CHANGE_ME_random_32_bytes_hex       # signs website visitor-account sessions
CHATBOT_SESSION_SECRET=CHANGE_ME_random_32_bytes_hex    # signs chatbot account sessions


# ─── 3. Admin panel sign-in ───────────────────────────────────────────────────
# Without DATABASE_URL the admin uses ONE shared password (below). With DATABASE_URL it uses personal accounts
# (create the first with:  npm run create:admin -- --name "…" --email … --password "…") and this is ignored.
# [REQUIRED when DATABASE_URL is not set] 'changeme' is refused in production.
ADMIN_PASSWORD=CHANGE_ME_long_unique_password


# ─── 4. Database (Postgres) ───────────────────────────────────────────────────
# [OPTIONAL today, REQUIRED for: personal admin accounts, leads inbox, CMS records in the database, OTP,
#  centres/cities tables, audit log, redirect manager.] Without it the site runs from the file store
# (data/cms/store.json) and the shared admin password; admin edits cannot persist on Vercel's read-only disk.
# After setting it run, once, from a machine that can reach the database:   npm run db:migrate
# Then seed the centres/cities tables:                                       npm run seed:locations
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true


# ─── 5. Content source ────────────────────────────────────────────────────────
# 'admin' (default) = the Admin CMS: Postgres when DATABASE_URL is set, otherwise the file store.
# 'local' = read the repo fixtures directly and ignore admin edits.
CONTENT_SOURCE=admin


# ─── 6. Rate limiting & client IP ─────────────────────────────────────────────
# [REQUIRED on Vercel] The in-memory limiter counts per instance. Production refuses to boot on it unless you
# accept that explicitly (fine for one always-on instance / serverless with modest traffic).
RATE_LIMIT_ALLOW_MEMORY=true
# How many proxies of yours append to X-Forwarded-For (default 1). Vercel's own header is used automatically.
# TRUSTED_PROXY_HOPS=1


# ─── 7. Enquiries → CRM (Smartrain) ───────────────────────────────────────────
# [RECOMMENDED] Hands every enquiry that has an email and a mapped centre to the CRM. Without these the leads are
# stored (database) or logged, not forwarded.
CRM_PROVIDER=smartrain
CRM_ENDPOINT=https://crm.smartrain.org/externalInquirySave
# CRM_API_KEY=                       # only if the CRM ever requires one (it currently does not)


# ─── 8. Mobile OTP verification on enquiry forms ──────────────────────────────
# Off by default. To switch on, ALL of these are needed, plus DATABASE_URL (attempt limits must be shared) and
# the otp_challenges table (npm run db:migrate). Set BOTH flags together.
OTP_ENABLED=false
NEXT_PUBLIC_OTP_ENABLED=false
# OTP_SECRET=CHANGE_ME_random_32_bytes_hex
# SMS_AUTH_KEY=CHANGE_ME_gateway_key                 # SERVER-SIDE secret; never NEXT_PUBLIC_
# SMS_OTP_TEMPLATE_ID=1107171350535143860            # DLT template: "Your OTP code is {#var#} - Jetking Infotrain Ltd"
# SMS_SENDER_ID=JTKING
# SMS_ROUTE=1
# SMS_ENDPOINT=https://msg.clickconnectmedia.in/http-tokenkeyapi.php
# Never set OTP_DEV_ECHO in production.


# ─── 9. Jetking AI assistant (chatbot) ────────────────────────────────────────
# [RECOMMENDED] The assistant answers from the site's own knowledge base; the key adds composed answers.
OPENAI_API_KEY=CHANGE_ME_sk-…
GUIDE_ENABLED=true
GUIDE_MODEL=gpt-4o
# PLANNER_MODEL=gpt-4o-mini
# PERSONA_INFER_MODEL=gpt-4o-mini
# Keep false: answer only from the Jetking knowledge base, never from general model knowledge.
JK_ALLOW_GENERAL_ANSWERS=false
JK_ANSWER_GATE=0.42
JK_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
JK_LEXICAL_WEIGHT=0.08
JK_LEXICAL_DEPTH=25
JK_CITY_BOOST=0.2
JK_RETRIEVAL_MODE=auto
# Local model fallback (not available on Vercel; leave unset there):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=jetking-assistant


# ─── 10. Personalisation ──────────────────────────────────────────────────────
# Default (unset): nothing is inferred about visitors; content adapts only to an audience the visitor picks.
# NEXT_PUBLIC_PERSONA_MODE=adaptive


# ─── 11. Logging & error reporting ────────────────────────────────────────────
# Lead details are masked in logs in production. 'true' logs full payloads (only if your logs are access-controlled).
LOG_LEAD_PAYLOADS=false
# [OPTIONAL] POST client/server error reports to this URL (e.g. a Slack/Teams incoming webhook).
# ERROR_WEBHOOK_URL=https://hooks.example.com/…


# ─── 12. Analytics ────────────────────────────────────────────────────────────
# [OPTIONAL] Tracking helpers exist but no loader is wired yet; setting these does nothing until one is added.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ─── Do NOT set in production ─────────────────────────────────────────────────
# NEXT_PUBLIC_SHOW_INSPECTOR   (persona debug overlay)
# NEXT_PUBLIC_SHOW_DESIGN_KIT  (internal design-kit page)
# OTP_DEV_ECHO                 (returns OTP codes to the browser)
# BUILD_STANDALONE             (only for a self-hosted Docker build)
