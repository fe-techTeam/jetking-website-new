# ══════════════════════════════════════════════════════════════════════════════
# Jetking — PRODUCTION environment template  (placeholders only, never real secrets)
#
# Where:  Vercel → Project → Settings → Environment Variables → Production
#         (or: vercel env add NAME production --sensitive). Mark every secret "Sensitive".
# After any change: redeploy. NEXT_PUBLIC_* values are baked in at build time.
# Random secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Section 1 = must set.  Section 2 = should set.  Section 3 = optional; every line there is a
# commented default — uncomment only to change it.  Full reference: docs/ENVIRONMENT.md
# ══════════════════════════════════════════════════════════════════════════════


# ─── 1. REQUIRED ──────────────────────────────────────────────────────────────

# Public address of the site (no trailing slash): canonicals, sitemap, links in emails.
SITE_URL=https://www.jetking.com
NEXT_PUBLIC_SITE_URL=https://www.jetking.com

# Five different random secrets — the server refuses to start in production without them.
PERSONA_COOKIE_SECRET=CHANGE_ME_random_32_bytes_hex
REVALIDATE_SECRET=CHANGE_ME_random_32_bytes_hex
ADMIN_SESSION_SECRET=CHANGE_ME_random_32_bytes_hex
USER_SESSION_SECRET=CHANGE_ME_random_32_bytes_hex
CHATBOT_SESSION_SECRET=CHANGE_ME_random_32_bytes_hex

# Admin sign-in when there is no database: one shared password ('changeme' is refused).
# With DATABASE_URL set, staff use personal accounts and this is ignored.
ADMIN_PASSWORD=CHANGE_ME_long_unique_password

# Read published content from the Admin CMS, hide "To be updated" tiles, accept the in-memory rate limiter.
CONTENT_SOURCE=admin
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
RATE_LIMIT_ALLOW_MEMORY=true


# ─── 2. RECOMMENDED ───────────────────────────────────────────────────────────

# Database (Postgres) — needed for staff accounts & roles, leads inbox, OTP, audit log, centres/cities tables.
# Without it the site runs from data/cms/store.json and admin edits cannot be saved on Vercel.
# After setting it, once:  npm run db:migrate   then   npm run seed:locations
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true

# Contact details shown on the site.
# National toll-free number shown on every Call button and in the footer.
NEXT_PUBLIC_PHONE=07666830000
NEXT_PUBLIC_WHATSAPP_NUMBER=919XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I would like to know more about Jetking courses.

# Enquiries → CRM (Smartrain). Without it leads are stored/logged but not forwarded.
CRM_PROVIDER=smartrain
CRM_ENDPOINT=https://crm.smartrain.org/externalInquirySave

# Outgoing email (SMTP): welcome / password emails to staff, "reset your password" link for visitors.
# Off unless MAIL_DRIVER=smtp. For Gmail, MAIL_PASSWORD must be an App Password.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_mailbox@example.com
MAIL_PASSWORD=CHANGE_ME_app_password
MAIL_FROM_NAME=Jetking
MAIL_ENCRYPTION=TLS
NEXT_PUBLIC_EMAIL_RESET_ENABLED=true

# Jetking AI assistant. Without a key it answers from the site's own knowledge base only.
OPENAI_API_KEY=CHANGE_ME_sk-…
GUIDE_ENABLED=true
GUIDE_PROVIDER=openai
GUIDE_MODEL=gpt-4o


# ─── 3. OPTIONAL — defaults shown, uncomment to change ────────────────────────

# Mobile OTP on enquiry forms / login. Needs DATABASE_URL, the SMS keys, and BOTH flags set together.
# OTP_ENABLED=false
# NEXT_PUBLIC_OTP_ENABLED=false
# OTP_SECRET=CHANGE_ME_random_32_bytes_hex
# SMS_AUTH_KEY=CHANGE_ME_gateway_key
# SMS_OTP_TEMPLATE_ID=
# SMS_SENDER_ID=JTKING
# SMS_ROUTE=1
# SMS_ENDPOINT=https://msg.clickconnectmedia.in/http-tokenkeyapi.php

# Analytics & ad tags — the live site's own are built in and run only on the real production site
# (never on staging/preview). An empty value switches that tag off.
# NEXT_PUBLIC_TRACKING_ENABLED=true
# NEXT_PUBLIC_GTM_ID=GTM-NS3S5GL
# NEXT_PUBLIC_GA_IDS=G-0X1JFRD2CY,G-W63BK7Z7N8,AW-16690495274
# NEXT_PUBLIC_META_PIXEL_IDS=712749829308803,982141604187576
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Search engines: leave unset on the real site; set to false on staging (also turns all tags off).
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Site details shown in the header/footer (defaults are the published Jetking values).
# NEXT_PUBLIC_HELPLINE=07666830000
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/JetkingOfficial/
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/jetkingofficial/
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/c/JetkingOfficial
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://in.linkedin.com/company/jetking
# NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/JetkingLtd

# Security headers: extra hosts a new third-party script/API/frame/image needs (space- or comma-separated).
# CSP_SCRIPT_SRC=
# CSP_CONNECT_SRC=
# CSP_FRAME_SRC=
# CSP_IMG_SRC=
# IMAGE_REMOTE_HOSTS=www.jetking.com

# Proxies, rate limiting, logging, errors.
# TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_STORE=memory
# REDIS_URL=
# LOG_LEAD_PAYLOADS=false
# ERROR_WEBHOOK_URL=
# CRM_API_KEY=
# MAIL_FROM_ADDRESS=

# Assistant tuning & other providers.
# OPENAI_BASE_URL=https://api.openai.com/v1
# PLANNER_MODEL=gpt-4o-mini
# PERSONA_INFER_MODEL=gpt-4o-mini
# NEXT_PUBLIC_PERSONA_MODE=adaptive
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=jetking-assistant
# OLLAMA_TIMEOUT_MS=40000
# JK_ALLOW_GENERAL_ANSWERS=false
# JK_ANSWER_GATE=0.42
# JK_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# JK_RETRIEVAL_MODE=auto
# JK_LEXICAL_WEIGHT=0.08
# JK_LEXICAL_DEPTH=25
# JK_LEXICAL_SATURATION=6
# JK_CITY_BOOST=0.2
# JK_CITY_MATCH_FLOOR=0.6
# JK_AUTHORITY_WEIGHT=0.15
# JK_INDEX_PATH=
# JK_EMBED_DIM=384
# JK_EMBED_BATCH=64

# Legacy (leave unset).
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=


# ─── Never set in production ──────────────────────────────────────────────────
# NEXT_PUBLIC_SHOW_INSPECTOR, NEXT_PUBLIC_SHOW_DESIGN_KIT, OTP_DEV_ECHO, BUILD_STANDALONE
