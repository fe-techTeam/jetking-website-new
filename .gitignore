.DS_Store
*.pem
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo

# migration working files (large, regenerated)
/scripts/.cache/
# sync-content.mts's crawl response cache — actually written to <repo root>/.cache/crawl
/.cache/
/data/legacy-crawl/
/data/cms/embeddings.json
# store.json is tracked (not ignored): Supabase isn't wired up for reads yet (see
# src/lib/cms/store.ts), so this file is the actual, live production content
# source right now, not just an offline dev fallback — it has to ship with the repo
# or every deploy reseeds from the fixtures and silently drops any admin-panel edit.

.vercel
.env*

# chatbot accounts + chats (file fallback when DATABASE_URL is unset — holds password hashes)
/data/chatbot/
# atomic-write leftovers from the admin CMS store
/data/cms/*.tmp
